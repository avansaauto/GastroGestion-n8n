# Variables públicas permitidas en el navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la API en Railway (https://*.up.railway.app), sin barra final.
# Tiene que existir en el servicio web antes del build: Vite la incluye en el bundle.
# En desarrollo, vacío usa el proxy local de Vite. No usar un dominio propio de API.
VITE_API_URL=

# Frontend previsto: https://gastrogest.app
# Pendiente al desplegar Vercel:
# - Site URL y Redirect URLs de Supabase Auth = https://gastrogest.app
# - FRONT_URL de la API = https://gastrogest.app
