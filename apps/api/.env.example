# Railway inyecta PORT. No hace falta fijarlo en el servicio.
PORT=3001

# Orígenes del navegador, separados por coma. En producción:
# FRONT_URL=https://gastrogest.app
# No usar un dominio propio para la API.
FRONT_URL=http://localhost:5173

# Supabase SENDA — anon + JWT del usuario respetan RLS.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# Solo API. RPC de escritura de facturas (save/cancel/map). Nunca el frontend ni apps/web.
# Analyze y lecturas siguen con JWT del usuario + SUPABASE_ANON_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Lector inteligente de facturas — solo backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Trabajos de análisis. Carpeta privada local, fuera de la web.
# Si está vacío, la API usa apps/api/.local/invoice-analysis-jobs. Una sola máquina.
# INVOICE_ANALYSIS_JOBS_DIR=

# Webhook saliente de n8n Cloud. Solo el servidor. HTTPS, sin usuario, sin IP y sin query.
# El secreto autentica a SENDA frente a n8n. No es el token de callback ni un JWT.
# N8N_INVOICE_WEBHOOK_URL=https://tu-instancia.app.n8n.cloud/webhook/facturas
# N8N_INVOICE_WEBHOOK_SECRET=
# N8N_INVOICE_WEBHOOK_TIMEOUT_MS=30000

# Pepper HMAC de credenciales de integración (snd_). Solo backend.
# hash = HMAC-SHA256(pepper, secret). Nunca el frontend. Nunca service_role hacia n8n.
# INTEGRATION_AUTH_PEPPER=

# Cifrado AES-256-GCM de API Key y API Secret de Fudo. Solo backend.
# No es INTEGRATION_AUTH_PEPPER ni un token snd_. 32 bytes en base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PROVIDER_CREDENTIALS_KEY=

# Opcional. Si está vacío, "Sincronizar ahora" lee Fudo desde la API.
# Si está definido, la API solo avisa a n8n con jobId (sin secretos de Fudo).
# n8n debe llamar POST /api/integrations/fudo/sync-jobs/:jobId/run
# con una credencial snd_ de alcance fudo.sync.run.
# N8N_FUDO_CATALOG_WEBHOOK_URL=
# N8N_FUDO_CATALOG_WEBHOOK_SECRET=

# HMAC del análisis de facturas. Solo backend. No exponer al frontend ni al cliente JS.
# Si está vacío, /api/invoices/analyze sigue respondiendo sin token (compatibilidad).
# Obligatorio para POST /api/invoices.
INVOICE_ANALYSIS_HMAC_SECRET=

# Bucket privado de facturas. No crearlo desde el código; configurarlo en el Dashboard.
# Público: no. Path: {organization_id}/invoices/{file_sha256}.{ext}
INVOICE_STORAGE_BUCKET=invoice-documents
